{
  "manifest_version": 3,
  "name": "Faucet Auto-Claimer Pro",
  "version": "2.0",
  "description": "Production-ready Faucet Pro: Auto-claims with premium UI and enhanced security.",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://litepick.io/*",
    "https://dogepick.io/*",
    "https://solpick.io/*",
    "https://bnbpick.io/*",
    "https://tronpick.io/*",
    "https://polpick.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Faucet Auto-Claimer"
  },
  "content_scripts": [
    {
      "matches": [
        "https://litepick.io/*",
        "https://dogepick.io/*",
        "https://solpick.io/*",
        "https://bnbpick.io/*",
        "https://tronpick.io/*",
        "https://polpick.io/*"
      ],
      "js": ["constants.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
